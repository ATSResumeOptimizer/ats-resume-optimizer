# Copy this file to .env and fill in the values.
# Never commit .env to source control.

# ── API Security ──────────────────────────────────────────────────────────────
# Leave API_KEY empty to disable auth (convenient for local dev).
# Set a long random string in production: openssl rand -hex 32
API_KEY=

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: openai | azure | anthropic | openrouter | groq | ollama
LLM_PROVIDER=openrouter

# Model name — depends on the provider chosen above:
#   openai      → gpt-4o, gpt-4o-mini
#   azure       → your deployment name
#   anthropic   → claude-3-5-sonnet-20241022
#   openrouter  → openai/gpt-4o, anthropic/claude-3-5-sonnet, google/gemini-pro
#   groq        → llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
#   ollama      → llama3.2, llama3.1, mistral, gemma3, phi4, qwen2.5
LLM_MODEL=openai/gpt-4o

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
# Optional – defaults shown:
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=ATS Resume Optimizer

# ── OpenAI (only needed if LLM_PROVIDER=openai) ───────────────────────────────
OPENAI_API_KEY=sk-...

# ── Azure OpenAI (only needed if LLM_PROVIDER=azure) ─────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Anthropic (only needed if LLM_PROVIDER=anthropic) ────────────────────────
ANTHROPIC_API_KEY=

# ── Groq (only needed if LLM_PROVIDER=groq) ──────────────────────────────────
# Get a free API key at https://console.groq.com
GROQ_API_KEY=gsk_...
# Optional – default shown:
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Ollama (only needed if LLM_PROVIDER=ollama) ───────────────────────────────
# Run locally: ollama serve && ollama pull llama3.2
# No API key required.
# Optional – default shown:
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Database (multi-tenant B2B layer) ────────────────────────────────────────
# SQLite is used by default (no setup needed for local dev).
# For production switch to PostgreSQL:
DATABASE_URL=sqlite:///./ats_optimizer.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost/ats_optimizer

# ── Redis (required only for async /v1/jobs and /v1/batch endpoints) ─────────
# Start Redis locally: redis-server (or: docker run -p 6379:6379 redis)
REDIS_URL=redis://localhost:6379

# ── Job data retention (days before purge task deletes completed job data) ────
JOB_DATA_RETENTION_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Dev default: Vite dev server on port 5173.
# Production: set to your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
